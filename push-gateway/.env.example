HTTP_ADDR=:8080
# Only listed reverse proxies may supply X-Forwarded-For for registration rate limits.
TRUSTED_PROXY_CIDRS=
DATABASE_URL=postgres://push_gateway:change-me@localhost:5432/push_gateway?sslmode=disable
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Comma-separated old keys retained only while old ciphertext is being rotated.
DATA_ENCRYPTION_PREVIOUS_KEYS=

# Optional management API. Configure both values to enable /api/admin/v1.
PUSH_ADMIN_USERNAME=
# Argon2id PHC string; generate offline and keep the original password secret.
PUSH_ADMIN_PASSWORD_HASH=
PUSH_ADMIN_COOKIE_SECURE=true
PUSH_ADMIN_SESSION_TTL=12h

# Use fake for local tests. Production can enable apns and the selected Android provider.
PUSH_PROVIDERS=fake
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=cloud.baizhi.chat
# APNS_PRIVATE_KEY_BASE64=
# JPUSH_APP_KEY=
# JPUSH_MASTER_SECRET=
DEFAULT_GRANT_TTL=720h
DEFAULT_NOTIFICATION_TTL=5m
MAX_NOTIFICATION_TTL=1h
WORKER_POLL_INTERVAL=1s
JOB_RETENTION=168h
# Expired/revoked grants and abandoned installations are removed after this period.
INSTALLATION_RETENTION=2160h
WORKER_BATCH_SIZE=50
MAX_JOBS_PER_GRANT_MINUTE=120
MAX_REGISTRATIONS_PER_IP_MINUTE=20
MAX_REGISTRATIONS_GLOBAL_MINUTE=1000
MAX_GRANT_ROTATIONS_PER_INSTALLATION_MINUTE=10
MAX_NOTIFICATIONS_GLOBAL_MINUTE=10000
