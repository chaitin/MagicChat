{
  "expo": {
    "name": "即应",
    "slug": "magicchat-mobile",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "magicchat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "cloud.baizhi.chat",
      "buildNumber": "13",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSPhotoLibraryAddUsageDescription": "即应需要将您主动保存的聊天图片写入相册，例如将联系人发送的图片保存到系统“照片”。",
        "NSPhotoLibraryUsageDescription": "即应需要访问您选择的照片和视频，用于在聊天中发送图片或视频。"
      }
    },
    "android": {
      "package": "cloud.baizhi.chat",
      "versionCode": 13,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#04C9BD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "允许即应使用相机扫描二维码"
        }
      ],
      "./plugins/with-message-selection-menu",
      "./plugins/with-animated-webp",
      "./plugins/with-jpush-vendor-channels",
      "expo-notifications",
      "./plugins/with-apns-environments",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo",
            "video"
          ],
          "photosPermission": "即应需要访问您选择的照片和视频，用于在聊天中发送图片或视频。",
          "savePhotosPermission": "即应需要将您主动保存的聊天图片写入相册，例如将联系人发送的图片保存到系统“照片”。"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "允许即应使用相机拍摄并发送图片",
          "microphonePermission": "允许即应使用麦克风录制并发送语音消息",
          "photosPermission": "即应需要访问您选择的照片和视频，用于在聊天中发送图片或视频。"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDEDED",
          "dark": {
            "backgroundColor": "#111111",
            "image": "./assets/images/splash-logo.png"
          },
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 56
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "允许即应使用麦克风录制并发送语音消息"
        }
      ],
      "expo-status-bar",
      "expo-video",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
