---
import { Icon } from 'astro-icon/components';
import { ActionButton } from './ActionButton';
import { CopyCommandButton } from './CopyCommandButton';
import '../styles/deployment.css';

const command = 'bash -c "$(curl -sSLk https://jiying.chat/releases/install.sh)"';
const benefits = [
  ['tabler:shield-check', '数据由你管理', '将团队的消息、文档与项目保存在自己的服务器上，自主安排访问权限、数据备份与保留策略。'],
  ['tabler:server', '独立的运行环境', '在自己的基础设施中运行，按团队的节奏安排升级和维护，掌握服务的配置与运行状态。'],
  ['tabler:plug-connected', '按业务自由扩展', '基于开源代码定制工作空间，选择适合的模型与工具，连接已有业务系统，构建团队专属的协作方式。'],
];
---

<section class="studio-section-band studio-deploy" id="deployment" aria-labelledby="deployment-title">
  <div class="studio-container">
  <div class="studio-section-heading">
    <span class="studio-eyebrow"><i></i>独立部署 <span>SELF-HOSTED</span></span>
    <h2 id="deployment-title">部署独立的<span>即应服务器</span></h2>
    <p>一个命令，搭建属于自己团队的协作空间。<br class="studio-mobile-break" />让数据、环境和扩展能力都由你掌握。</p>
  </div>

  <div class="studio-install" data-install-terminal>
    <div class="studio-install-terminal" aria-label="安装命令终端窗口">
      <div class="studio-terminal-bar">
        <span class="studio-terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <div data-copy-controls hidden><CopyCommandButton /></div>
      </div>
      <div class="studio-terminal-body">
        <div class="studio-terminal-command"><span aria-hidden="true">$</span><pre><code data-install-command>{command}</code></pre></div>
      </div>
    </div>
    <div class="studio-deploy-requirements" aria-label="运行环境要求">
      <p>仅需 <strong>1 核 CPU + 1 GB 内存</strong>轻量配置</p>
      <ActionButton href="https://jiying.docs.baizhi.cloud/" label="查看详细部署文档" trailingIcon="arrow-up-right" variant="link" external />
    </div>
    <p class="studio-copy-status" role="status" aria-live="polite" data-copy-status hidden></p>
  </div>

  <div class="studio-deploy-benefits">
    {benefits.map(([icon, title, description]) => <article><Icon name={icon} size={23} aria-hidden="true" /><h3>{title}</h3><p>{description}</p></article>)}
  </div>
  </div>
</section>

<script>
  const terminal = document.querySelector<HTMLElement>('[data-install-terminal]');
  if (terminal) {
    const command = terminal.querySelector<HTMLElement>('[data-install-command]');
    const button = terminal.querySelector<HTMLButtonElement>('[data-copy-command]');
    const label = terminal.querySelector<HTMLElement>('[data-copy-label]');
    const status = terminal.querySelector<HTMLElement>('[data-copy-status]');
    const controls = terminal.querySelector<HTMLElement>('[data-copy-controls]');
    if (command && button && label && status && controls) {
      controls.hidden = false;
      button.addEventListener('click', async () => {
        button.disabled = true;
        try {
          await navigator.clipboard.writeText(command.textContent ?? '');
          label.textContent = '已复制';
          button.dataset.copyState = 'copied';
          button.setAttribute('aria-label', '已复制安装命令');
          status.hidden = true;
          status.textContent = '';
        } catch {
          const selection = window.getSelection();
          const range = document.createRange();
          range.selectNodeContents(command);
          selection?.removeAllRanges();
          selection?.addRange(range);
          label.textContent = '重新复制';
          button.dataset.copyState = 'idle';
          button.setAttribute('aria-label', '重新复制安装命令');
          status.hidden = false;
          status.textContent = '自动复制未成功，请手动复制上方安装命令。';
        } finally {
          button.disabled = false;
        }
      });
    }
  }
</script>
