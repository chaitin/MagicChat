---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioHero from '../components/StudioHero.astro';
import StudioWorkspace from '../components/StudioWorkspace.astro';
import DeploymentSection from '../components/DeploymentSection.astro';
import ClientsSection from '../components/ClientsSection.astro';
import OpennessSection from '../components/OpennessSection.astro';
import { ActionButton } from '../components/ActionButton';
import { FaqQuestion } from '../components/FaqQuestion';
import '../styles/homepage.css';

const title = '即应 - AI 时代的团队协作入口';
const description = '即应是一款开源的即时通讯工具，连接消息、知识与任务，让 Agent 深度融入工作流，成为真正能参与协作、推动执行的数字员工。';
const siteOrigin = Astro.site ?? Astro.url.origin;
const pageUrl = new URL(import.meta.env.BASE_URL, siteOrigin).href;
const logoUrl = new URL(`${import.meta.env.BASE_URL}favicon.webp`, siteOrigin).href;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: '即应', url: pageUrl, logo: logoUrl },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: '即应', alternateName: 'MagicChat', applicationCategory: 'BusinessApplication', operatingSystem: 'Web, macOS, Windows, Linux, iOS, Android', description, url: pageUrl },
];
const teamBenefits = [
  ['tabler:messages', '上下文不再散落各处', '消息、文档与项目连在一起，让 AI 理解工作背景，减少翻找资料和反复解释。'],
  ['tabler:brain', '从讨论中找到重点', '让 AI 整理群聊、归纳进展、提取待办，把人的精力留给判断与创造。'],
  ['tabler:checkbox', '让每件事都有下一步', '将共识整理为任务，明确负责人和时间，确认后创建并持续跟进。'],
  ['tabler:shield-check', '信息与操作自主可控', 'AI 遵循用户权限，重要操作由你确认；通过私有化部署，让数据留在自己的环境中。'],
];
const comparisonRows = [
  ['企业即时通讯', true, true, true, true, true, true, true],
  ['Web、桌面与移动端', true, true, true, true, true, true, true],
  ['私有化部署', true, false, true, false, false, true, true],
  ['核心产品代码开源', true, false, false, false, false, true, true],
  ['在线文档', true, true, true, true, true, false, false],
  ['目标管理', false, true, true, false, false, false, false],
  ['项目管理', true, true, true, false, false, false, false],
  ['任务管理', true, true, true, true, true, true, false],
  ['开放 API 与应用扩展', true, true, true, true, true, true, true],
  ['内置 AI 助手', true, true, true, true, true, false, false],
];
const faqs = [
  ['即应和飞书、钉钉等企业 IM 有什么不同？', '飞书和钉钉提供成熟的团队协作生态；即应聚焦 AI 参与团队工作，让助理以独立应用身份接入消息、项目和任务，同时支持私有化部署与开源二次开发。'],
  ['我们的企业数据如何保持自主可控？', '即应支持部署在企业自有服务器或云基础设施中，数据访问遵循用户权限。团队可以自主选择接入的模型和外部工具，并根据业务要求管理数据流向。'],
  ['AI 助理具体能帮我们做什么？', '在授权范围内，AI 助理可以查询聊天记录和项目信息、总结讨论、整理待办、起草内容，并在用户明确授权后代发消息。创建和修改任务前，助理会展示参数并请求确认。'],
  ['部署即应需要什么样的基础条件？', '即应提供 Docker / Compose 等容器化部署配置，支持 Web、桌面与移动客户端。可以先在线体验，再参考部署文档准备自己的服务器和相关服务。'],
  ['即应是免费开源的吗？', '即应的核心产品代码基于 AGPL-3.0 许可证开源，支持企业与个人免费安装、使用和私有化部署。使用、修改或分发时，请遵循许可证的具体要求。'],
  ['我们团队可以基于即应进行二次开发吗？', '可以。你可以根据业务需求定制界面、创建应用，并接入模型、MCP 工具或已有业务系统，扩展团队的工作方式。'],
];
---

<BaseLayout title={title} description={description} schema={schema} bodyClass="page-studio">
  <main id="main-content" class="studio-main">
    <section class="studio-hero studio-container" aria-labelledby="hero-title">
      <div class="studio-hero-copy">
        <h1 id="hero-title"><span class="studio-title-shadow" aria-hidden="true">即应 Chat</span>即应 Chat</h1>
        <p class="studio-hero-tagline">AI 时代的团队协作入口</p>
        <p class="studio-hero-description">即应是一款开源的即时通讯工具。让沟通与执行在同一个空间完成，让 AI 助理融入你的日常工作。连接消息、知识与任务，让 AI 真正成为团队的一员。</p>
        <div class="studio-actions">
          <ActionButton href="#deployment" label="独立部署" icon="server" size="lg" />
          <ActionButton href="#clients" label="下载客户端" icon="download" variant="outline" size="lg" />
        </div>
      </div>
      <StudioHero />
    </section>

    <div class="studio-foundation studio-container" aria-label="即应协作能力">
      <span>一个入口，连接所有工作</span>
      <div><span><Icon name="tabler:message-circle" size={20} />即时沟通</span><span><Icon name="tabler:layout-kanban" size={20} />项目协作</span><span><Icon name="tabler:checkbox" size={20} />任务管理</span><span><Icon name="tabler:file-text" size={20} />协作文档</span><span><Icon name="tabler:robot" size={20} />AI 助理</span></div>
    </div>

    <DeploymentSection />

    <section class="studio-section studio-container" id="solution" aria-labelledby="solution-title">
      <div class="studio-section-heading"><span class="studio-eyebrow"><i></i>产品能力 <span>THE WORKSPACE</span></span><h2 id="solution-title">让 AI 真正成为<span>团队的一员</span></h2><p>把分散的信息连起来，让 AI 理解背景、参与协作。<br class="studio-mobile-break" />少一些反复，多一些进展。</p></div>
      <StudioWorkspace />
      <div class="studio-capabilities" id="why" aria-label="为什么选择即应">{teamBenefits.map(([icon, heading, body]) => <article><Icon name={icon} size={23} aria-hidden="true" /><h3>{heading}</h3><p>{body}</p></article>)}</div>
    </section>

    <ClientsSection />

    <OpennessSection />

    <section class="studio-section-band" id="capabilities" aria-labelledby="capability-title">
      <div class="studio-container">
      <div class="studio-section-heading"><span class="studio-eyebrow"><i></i>产品对比 <span>THE DIFFERENCE</span></span><h2 id="capability-title">飞书、钉钉、企微的<span>开源平替</span></h2><p>从团队协作到部署方式，找到适合你的工作空间。</p></div>
      <div class="studio-comparison" role="region" aria-label="产品能力对比，可横向滚动" tabindex="0"><table><thead><tr><th scope="col">比较维度</th><th scope="col" class="studio-highlight">即应</th>{['飞书', '钉钉', '企业微信', 'Slack', 'Mattermost', 'Rocket.Chat'].map((product) => <th scope="col">{product}</th>)}</tr></thead><tbody>{comparisonRows.map(([dimension, ...support]) => <tr><th scope="row">{dimension}</th>{support.map((supported, index) => <td class:list={[index === 0 && 'studio-highlight', !supported && 'studio-unsupported']}><span class="sr-only">{supported ? '支持' : '不支持'}</span><Icon name={supported ? 'tabler:check' : 'tabler:x'} size={17} aria-hidden="true" /></td>)}</tr>)}</tbody></table></div>
      </div>
    </section>

    <section class="studio-section studio-container studio-faq" id="faq" aria-labelledby="faq-title">
      <div class="studio-section-heading"><span class="studio-eyebrow"><i></i>常见问题 <span>FAQ</span></span><h2 id="faq-title">你可能还想了解</h2><p>关于产品、部署和 AI 协作。</p><ActionButton className="studio-text-action" href="https://jiying.docs.baizhi.cloud/" label="查看产品文档" trailingIcon="arrow-up-right" variant="link" external /></div>
      <div class="studio-faq-list">{faqs.map(([question, answer], index) => <details name="homepage-faq" open={index === 0}><FaqQuestion question={question} /><p>{answer}</p></details>)}</div>
    </section>

    <section class="studio-start studio-container" id="get-started" aria-labelledby="start-title">
      <div><h2 id="start-title">现在开始使用<span>即用</span></h2><p>在线体验即应，或在自己的环境中部署。</p></div>
      <div class="studio-actions"><ActionButton href="https://app.jiying.chat/" label="在线体验" icon="monitor-play" size="lg" external /><ActionButton href="https://jiying.docs.baizhi.cloud/" label="私有化部署" icon="server" variant="outline" size="lg" external /></div>
    </section>
  </main>
</BaseLayout>
