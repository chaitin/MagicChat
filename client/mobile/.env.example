# The official JPush AppKey is built in. Set this only to override it for a
# separate development/test JPush application. Never place the Master Secret here.
JPUSH_APP_KEY=
JPUSH_CHANNEL=official

# Each vendor channel is packaged only when all values for that channel exist.
JPUSH_XIAOMI_APP_ID=
JPUSH_XIAOMI_APP_KEY=

JPUSH_VIVO_APP_ID=
JPUSH_VIVO_APP_KEY=

JPUSH_OPPO_APP_ID=
JPUSH_OPPO_APP_KEY=
JPUSH_OPPO_APP_SECRET=

# Absolute path, or a path relative to client/mobile, to Huawei's downloaded file.
JPUSH_HUAWEI_AGCONNECT_SERVICES=
