{
  "name": "jiying-desktop-next",
  "version": "2.0.0",
  "buildId": 20,
  "private": true,
  "description": "即应新桌面客户端",
  "author": "即应",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "setup:electron": "install-electron",
    "dev:web": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "pack:win": "pnpm build && electron-builder --win nsis --x64 --config electron-builder.yml",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@paper-design/shaders-react": "^0.0.80",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.45.0",
    "motion": "13.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.8.0",
    "remark-flexible-markers": "^1.3.6",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-supersub": "^1.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@infolektuell/noto-color-emoji": "0.2.0",
    "@tailwindcss/vite": "4.2.1",
    "@types/katex": "^0.16.8",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.1",
    "typescript": "6.0.2",
    "vite": "7.3.6"
  }
}
